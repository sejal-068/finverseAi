PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/finverseai
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Client Application URL (points to your running FinverseAI frontend)
CLIENT_URL=http://localhost:5000

# ==============================================================================
# EMAIL SERVICE CONFIGURATION (100% Free Tiers - Choose EITHER Option A or Option B)
# ==============================================================================

# OPTION A: RESEND (Recommended Free Tier - 3,000 emails/mo, 100/day, no credit card required)
# 1. Sign up free at https://resend.com
# 2. Generate an API Key under API Keys
# 3. Paste it below:
RESEND_API_KEY=re_your_api_key_here
# Note: For free accounts without custom domains, use: onboarding@resend.dev
EMAIL_FROM=FinverseAI <onboarding@resend.dev>

# OPTION B: GMAIL SMTP (Alternative Free Solution)
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Fill in below (leave RESEND_API_KEY blank):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
FROM_NAME=FinverseAI Security

# ==============================================================================
# GOOGLE OAUTH CONFIGURATION (Google Identity Services)
# ==============================================================================
# 1. Create a project at https://console.cloud.google.com/
# 2. Go to APIs & Services > Credentials > Create Credentials > OAuth client ID
# 3. Application type: Web application
# 4. Authorized JavaScript origins: http://localhost:5000, http://127.0.0.1:5000
# 5. Paste Client ID below:
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

